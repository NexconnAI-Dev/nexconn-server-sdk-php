{
    "name": "public-server/nexconn-server-sdk-php",
    "version": "0.1.0",
    "description": "OpenAPI specification aligned with the current Nexconn public documentation, PDF source documents, and generated SDK requirements.",
    "keywords": [
        "openapitools",
        "openapi-generator",
        "openapi",
        "php",
        "sdk",
        "rest",
        "api"
    ],
    "homepage": "https://gitlab2.rongcloud.net/public-server/nexconn-server-sdk-php",
    "license": "MIT",
    "authors": [
        {
            "name": "Nexconn",
            "homepage": "https://www.nexconn.ai/"
        }
    ],
    "require": {
        "php": "^8.1",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "guzzlehttp/guzzle": "^7.3",
        "guzzlehttp/psr7": "^1.7 || ^2.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^8.0 || ^9.0",
        "friendsofphp/php-cs-fixer": "^3.5"
    },
    "autoload": {
        "psr-4": { "NexConnServerSdkPhp\\" : "lib/" }
    },
    "autoload-dev": {
        "psr-4": { "NexConnServerSdkPhp\\Test\\" : "test/" }
    }
}
